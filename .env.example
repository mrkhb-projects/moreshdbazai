# =============================================================================
# متغیرهای محیطی «مرشد بازاری»
# این فایل را در فایل‌های .env.local (توسعه) یا در پنل Environment Variables
# سرویس Liara (تولید) کپی و مقداردهی کنید. هرگز فایل .env واقعی را کامیت نکنید.
# =============================================================================

# ---- تنظیمات عمومی برنامه --------------------------------------------------
# آدرس عمومی سایت (برای متادیتا، Open Graph و لینک‌سازی مطلق استفاده می‌شود)
NEXT_PUBLIC_SITE_URL=https://moreshdbazari.ir

# نام نمایشی پلتفرم (در صورت نیاز به تغییر متن برند بدون ادیت کد)
NEXT_PUBLIC_SITE_NAME=مرشد بازاری

# ---- پورت اجرا --------------------------------------------------------------
# روی Liara این مقدار به‌صورت خودکار تزریق می‌شود؛ نیازی به تنظیم دستی نیست.
# در محیط لوکال هم next start/dev بدون این متغیر روی 3000 اجرا می‌شود.
# PORT=3000

# ---- منبع داده بازار (tgju.org) --------------------------------------------
# آدرس سرویس داده لحظه‌ای که برای دریافت قیمت ارز/طلا/سکه استفاده می‌شود.
# در صورت خالی بودن یا در دسترس نبودن، برنامه به‌صورت خودکار از داده نمونه
# (Mock) استفاده می‌کند تا سایت هرگز از کار نیفتد.
TGJU_API_URL=https://call1.tgju.org/ajax.json

# مدت زمان (ثانیه) کش‌شدن پاسخ سرویس قیمت روی سرور قبل از رفرش مجدد
PRICE_CACHE_SECONDS=60

# ---- پایگاه‌داده (اختیاری / برای توسعه‌های آینده) --------------------------
# در نسخه فعلی پروژه از داده نمونه استفاده می‌شود و به دیتابیس نیاز ندارد.
# هر زمان خواستید PostgreSQL روی Liara را متصل کنید، این مقدار را از پنل
# دیتابیس لیارا کپی کرده و در Environment Variables برنامه قرار دهید،
# سپس دستورهای Prisma را طبق README اجرا کنید.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ---- احراز هویت با کد پیامکی (فعلاً حالت توسعه/Mock) ------------------------
# در محیط توسعه، کد تایید همیشه ثابت و در کنسول چاپ می‌شود و نیازی به
# سرویس پیامک واقعی نیست.
AUTH_MODE=mock

# کلید امضای نشست کاربر (JWT/Cookie). یک رشته تصادفی و طولانی تولید کنید:
# مثال تولید: `openssl rand -base64 32`
AUTH_SECRET=

# اطلاعات سرویس پیامک ایرانی (مثلاً کاوه‌نگار/ملی‌پیامک) — وقتی آماده شد
# مقداردهی کنید و AUTH_MODE را به sms تغییر دهید. تا آن زمان خالی بمانند.
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER=
